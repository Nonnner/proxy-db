# Copy this file to .env and replace all placeholder values before running.
# Generate a 32-byte random key: openssl rand -hex 32

# Encryption keys (hex-encoded 32 bytes each)
PROXY_KEY_KEY_USERS_EMAIL=<replace with: openssl rand -hex 32>
PROXY_KEY_KEY_USERS_NAME=<replace with: openssl rand -hex 32>
PROXY_KEY_KEY_USERS_PHONE=<replace with: openssl rand -hex 32>
